FROM node:22.23.4 AS build
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .

ARG VITE_BACKEND_URL
ARG VITE_BPP_URL
ARG VITE_BAP_URL
ARG VITE_BASE_URL
ENV VITE_BACKEND_URL=$VITE_BACKEND_URL
ENV VITE_BPP_URL=$VITE_BPP_URL
ENV VITE_BAP_URL=$VITE_BAP_URL
ENV VITE_BASE_URL=$VITE_BASE_URL
ARG VITE_ENVIRONMENT
ENV VITE_ENVIRONMENT=$VITE_ENVIRONMENT
ARG VITE_DEVELOPER_GUIDE_BACKEND_URL
ENV VITE_DEVELOPER_GUIDE_BACKEND_URL=$VITE_DEVELOPER_GUIDE_BACKEND_URL
ARG VITE_ENABLE_DEV_GUIDE
ENV VITE_ENABLE_DEV_GUIDE=$VITE_ENABLE_DEV_GUIDE
ARG VITE_DEV_GUIDE_ALL_DOMAINS
ENV VITE_DEV_GUIDE_ALL_DOMAINS=$VITE_DEV_GUIDE_ALL_DOMAINS
ARG VITE_ONDC_PORTAL_URL
ENV VITE_ONDC_PORTAL_URL=$VITE_ONDC_PORTAL_URL

RUN npm run build
FROM node:22.23.4-slim
WORKDIR /app
RUN npm install -g serve
COPY --from=build /app/dist /app/dist
EXPOSE 5001
CMD ["serve", "-s", "dist", "-l", "5001"]
